    },
    {
      "name": "benchmark-harness",
      "argv": ["python3", "scripts/run_debtmap_benchmark.py", "--output", "RESULT.json", "--input", "Examples/Sources/Example.swift", "--input", ".scma.example.json", "--analyzer", "SwiftSCMA", "--workload-family", "SwiftSCMA", "--command-fingerprint", "WORKLOAD", "--analysis-mode", "MODE", "--optional-context", "CONTEXT", "--", "COMMAND"]
    },
    {
      "name": "enforce-merge-budget",
      "argv": [".build/release/scma", "performance-gate", "BASELINE.json", "CANDIDATE.json", "--name", "BUDGET", "--max-wall-clock-regression", "PERCENT", "--max-peak-memory-regression", "PERCENT", "--output", "EVALUATION.json"]
