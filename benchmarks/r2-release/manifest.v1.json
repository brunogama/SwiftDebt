      "repository-cache-report-sha256-and-canonical-sha256",
      "repository-cache-store-sha256-before-and-after",
      "cache-disposition-reuse-recompute-write-and-invalidation-counts",
      "host-load-average-before-and-after"
    ],
    "cacheStateProtocol": "Warm and one-file-edit scenarios create one validated compatible cache seed outside timed commands. Every sample copies those exact bytes into a fresh state directory and resets from the same generated corpus."
  },
  "budgetPolicy": {
    "maximumWallClockRegressionPercent": 10.0,
