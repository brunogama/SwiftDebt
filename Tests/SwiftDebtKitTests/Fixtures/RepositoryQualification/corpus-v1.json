{
  "schemaVersion": 1,
  "corpusID": "swiftdebt-r2-repository-rule-qualification-v1",
  "authorLabelState": "provisional-pending-independent-review",
  "review": {
    "requiredQualifiedSwiftReviewers": 2,
    "reviewerSlots": [
      {
        "slot": "reviewer-1",
        "status": "pending"
      },
      {
        "slot": "reviewer-2",
        "status": "pending"
      }
    ],
    "adjudicationStatus": "pending"
  },
  "rules": [
    {
      "identity": "swiftdebt.refactoring.data-clumps",
      "semanticRevision": 2,
      "observableScope": "Closed groups of at least three exact local-name and normalized-type elements in at least two supported parameter or stored-property units.",
      "scopeExclusions": [
        "Compiler-resolved typealias and generic identity",
        "Semantic relationship between equal spellings in different binding contexts",
        "Tuple destructuring, inferred property types, local variables, and closure parameters"
      ],
      "knownFalsePositiveRisks": [
        "Equal local names and type spellings can describe unrelated concepts"
      ],
      "knownFalseNegativeRisks": [
        "Equivalent compiler-resolved types with different source spellings do not match",
        "Data groups outside supported declaration units are not observed"
      ]
    },
    {
      "identity": "swiftdebt.refactoring.repeated-switches",
      "semanticRevision": 2,
      "observableScope": "At least two switches in one textual module/type scope with the same simple discriminator and ordered normalized case-label shape.",
      "scopeExclusions": [
        "Compiler-resolved discriminator identity",
        "Compound, call, subscript, tuple, and optional-chain discriminator expressions",
        "Active-branch selection for conditional-compilation case elements"
      ],
      "knownFalsePositiveRisks": [
        "Equal discriminator spelling in one textual scope can bind to different declarations"
      ],
      "knownFalseNegativeRisks": [
        "Equivalent compiler-resolved discriminators with different source spelling do not match",
        "Case order differences remain distinct even when behavior happens to be equivalent"
      ]
    }
  ],
  "repositoryShapes": [
    {
      "id": "flat-single-module",
      "layout": "flat",
      "description": "One flat source root discovered by the CLI as module Workspace.",
      "families": [
        {
          "id": "dc-flat-functions-positive",
          "ruleIdentity": "swiftdebt.refactoring.data-clumps",
          "authorLabel": "positive",
          "count": 10,
          "template": "data-clumps-functions-positive",
          "rationale": "Two top-level functions repeat the same three named and typed parameters."
        },
        {
          "id": "dc-flat-name-mismatch",
          "ruleIdentity": "swiftdebt.refactoring.data-clumps",
          "authorLabel": "negative",
          "count": 10,
          "template": "data-clumps-name-mismatch",
          "rationale": "One of three local parameter names differs, leaving only two exact elements."
        },
        {
          "id": "dc-flat-type-mismatch",
          "ruleIdentity": "swiftdebt.refactoring.data-clumps",
          "authorLabel": "negative",
          "count": 10,
          "template": "data-clumps-type-mismatch",
          "rationale": "One of three parameter types differs, leaving only two exact elements."
        },
        {
          "id": "rs-flat-methods-positive",
          "ruleIdentity": "swiftdebt.refactoring.repeated-switches",
          "authorLabel": "positive",
          "count": 10,
          "template": "repeated-switches-methods-positive",
          "rationale": "Two methods in one nominal scope switch on the same identifier with the same ordered cases."
        },
        {
          "id": "rs-flat-discriminator-mismatch",
          "ruleIdentity": "swiftdebt.refactoring.repeated-switches",
          "authorLabel": "negative",
          "count": 10,
          "template": "repeated-switches-discriminator-mismatch",
          "rationale": "The switch shapes match but their simple discriminator identifiers differ."
        },
        {
          "id": "rs-flat-case-order-mismatch",
          "ruleIdentity": "swiftdebt.refactoring.repeated-switches",
          "authorLabel": "negative",
          "count": 10,
          "template": "repeated-switches-case-order-mismatch",
          "rationale": "The same cases occur in a different order, which is semantically relevant to matching."
        }
      ]
    },
    {
      "id": "nested-source-tree",
      "layout": "nested",
      "description": "Sources are distributed under nested feature directories and discovered recursively.",
      "families": [
        {
          "id": "dc-nested-properties-positive",
          "ruleIdentity": "swiftdebt.refactoring.data-clumps",
          "authorLabel": "positive",
          "count": 10,
          "template": "data-clumps-properties-positive",
          "rationale": "Two nominal types directly store the same three named and typed properties."
        },
        {
          "id": "dc-nested-only-two-shared",
          "ruleIdentity": "swiftdebt.refactoring.data-clumps",
          "authorLabel": "negative",
          "count": 10,
          "template": "data-clumps-only-two-shared",
          "rationale": "Two property groups share only two elements and each has a distinct third property."
        },
        {
          "id": "dc-nested-computed-properties",
          "ruleIdentity": "swiftdebt.refactoring.data-clumps",
          "authorLabel": "negative",
          "count": 10,
          "template": "data-clumps-computed-properties",
          "rationale": "The apparent second group consists only of computed properties, outside the stored-property scope."
        },
        {
          "id": "rs-nested-types-positive",
          "ruleIdentity": "swiftdebt.refactoring.repeated-switches",
          "authorLabel": "positive",
          "count": 10,
          "template": "repeated-switches-nested-positive",
          "rationale": "Two switches share a member-access discriminator and case shape inside one nested nominal scope."
        },
        {
          "id": "rs-nested-scope-mismatch",
          "ruleIdentity": "swiftdebt.refactoring.repeated-switches",
          "authorLabel": "negative",
          "count": 10,
          "template": "repeated-switches-scope-mismatch",
          "rationale": "Identical switches occur in two different nested nominal scopes."
        },
        {
          "id": "rs-nested-token-boundary",
          "ruleIdentity": "swiftdebt.refactoring.repeated-switches",
          "authorLabel": "negative",
          "count": 10,
          "template": "repeated-switches-token-boundary",
          "rationale": "Case labels differ only by a token boundary and must remain distinct."
        }
      ]
    },
    {
      "id": "explicit-multi-module",
      "layout": "manifest",
      "description": "An explicit CLI source manifest assigns files to three modules in a workspace-shaped tree.",
      "families": [
        {
          "id": "dc-modules-callable-kinds-positive",
          "ruleIdentity": "swiftdebt.refactoring.data-clumps",
          "authorLabel": "positive",
          "count": 10,
          "template": "data-clumps-init-subscript-positive",
          "rationale": "An initializer and subscript repeat the same three named and typed parameters."
        },
        {
          "id": "dc-modules-unnamed-parameters",
          "ruleIdentity": "swiftdebt.refactoring.data-clumps",
          "authorLabel": "negative",
          "count": 10,
          "template": "data-clumps-unnamed-parameters",
          "rationale": "The second callable uses only unnamed parameters, which do not enter the observed element set."
        },
        {
          "id": "dc-modules-token-boundary",
          "ruleIdentity": "swiftdebt.refactoring.data-clumps",
          "authorLabel": "negative",
          "count": 10,
          "template": "data-clumps-token-boundary",
          "rationale": "Opaque-type token sequences and similarly spelled nominal types retain distinct token boundaries."
        },
        {
          "id": "rs-modules-extensions-positive",
          "ruleIdentity": "swiftdebt.refactoring.repeated-switches",
          "authorLabel": "positive",
          "count": 10,
          "template": "repeated-switches-extensions-positive",
          "rationale": "Two extensions of one type in the same module contain the same switch shape."
        },
        {
          "id": "rs-modules-compound-discriminator",
          "ruleIdentity": "swiftdebt.refactoring.repeated-switches",
          "authorLabel": "negative",
          "count": 10,
          "template": "repeated-switches-compound-discriminator",
          "rationale": "Call expressions are outside the simple-discriminator observable scope."
        },
        {
          "id": "rs-modules-where-clause",
          "ruleIdentity": "swiftdebt.refactoring.repeated-switches",
          "authorLabel": "negative",
          "count": 10,
          "template": "repeated-switches-where-clause",
          "rationale": "A where clause changes the normalized ordered case-label shape."
        }
      ]
    }
  ],
